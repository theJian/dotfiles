;;; moonwalk-light-theme.el -*- lexical-binding: t; no-byte-compile: t; -*-
;; Colors copied from nvim-moonwalk/lua/moonwalk/palette/light.lua.
;; This theme has no runtime dependency on that checkout.
(require 'doom-themes)

(defface j/modeline-terminal '((t (:inherit mode-line)))
  "Moonwalk's terminal input mode block."
  :group 'doom-modeline-faces)

(def-doom-theme moonwalk-light
  "Moonwalk's light palette for Doom."
  :background-mode 'light
  ((bg         '("#e4e2e0"))
   (fg         '("#061f4a"))
   (bg-alt     '("#dcd8d0"))
   (fg-alt     '("#494440"))
   (base0      '("#f2ede9"))
   (base1      '("#e4e2e0"))
   (base2      '("#dcd8d0"))
   (base3      '("#9c958d"))
   (base4      '("#7d7e82"))
   (base5      '("#494440"))
   (base6      '("#061f4a"))
   (base7      '("#080808"))
   (base8      '("#080808"))
   (grey       base4)
   (red        '("#af1608"))
   (orange     '("#bd6500"))
   (green      '("#4c6129"))
   (teal       '("#00878a"))
   (yellow     '("#7a5000"))
   (blue       '("#0d50c5"))
   (dark-blue  '("#002fa7"))
   (magenta    '("#952197"))
   (violet     '("#5400a8"))
   (cyan       '("#006092"))
   (dark-cyan  '("#00566b"))
   (highlight blue)
   (vertical-bar base3)
   (selection '("#b8d2e5"))
   (builtin cyan)
   (comments base4)
   (doc-comments base5)
   (constants violet)
   (functions dark-blue)
   (keywords magenta)
   (methods cyan)
   (operators fg)
   (type yellow)
   (strings green)
   (variables fg)
   (numbers orange)
   (region selection)
   (error red)
   (warning yellow)
   (success green)
   (vc-modified yellow)
   (vc-added green)
   (vc-deleted red)
   (modeline-fg fg)
   (modeline-fg-alt base5)
   (modeline-bg bg-alt)
   (modeline-bg-alt bg)
   (modeline-bg-inactive bg)
   (modeline-fg-inactive base4))
  ((hl-line :background base0)
   (region :background selection :foreground fg)
   (isearch :background "#ffcf24" :foreground fg :weight 'bold)
   (lazy-highlight :background "#ffcf24" :foreground fg)
   (evil-ex-search :inherit 'isearch)
   (line-number :foreground base3 :background bg)
   (line-number-current-line :foreground dark-blue :background base0 :weight 'bold)
   (whitespace-tab :foreground base3 :background nil)
   (whitespace-trailing :foreground red :background "#fce3de")
   ;; Markdown code and tables share a face; use Moonwalk's pale popup surface.
   (markdown-code-face :background bg-alt)
   ;; Terminal palette for ghostel (matches alacritty/moonwalk.toml).
   ;; doom-themes maps ansi-color-* for light-theme readability, but
   ;; ghostel uses these faces as the literal16-color terminal palette.
   (ghostel-color-black          :foreground "#080808" :background "#080808")
   (ghostel-color-red            :foreground "#7a0047" :background "#7a0047")
   (ghostel-color-green          :foreground "#145b0e" :background "#145b0e")
   (ghostel-color-yellow         :foreground "#733a11" :background "#733a11")
   (ghostel-color-blue           :foreground "#002fa7" :background "#002fa7")
   (ghostel-color-magenta        :foreground "#5400a8" :background "#5400a8")
   (ghostel-color-cyan           :foreground "#00566b" :background "#00566b")
   (ghostel-color-white          :foreground "#9c958d" :background "#9c958d")
   (ghostel-color-bright-black   :foreground "#494440" :background "#494440")
   (ghostel-color-bright-red     :foreground "#af1608" :background "#af1608")
   (ghostel-color-bright-green   :foreground "#4c6129" :background "#4c6129")
   (ghostel-color-bright-yellow  :foreground "#7a5000" :background "#7a5000")
   (ghostel-color-bright-blue    :foreground "#0d50c5" :background "#0d50c5")
   (ghostel-color-bright-magenta :foreground "#952197" :background "#952197")
   (ghostel-color-bright-cyan    :foreground "#006092" :background "#006092")
   (ghostel-color-bright-white   :foreground "#ffffff" :background "#ffffff")
   (vertico-current :background "#ffebd1" :foreground fg)
   (corfu-default :background bg-alt :foreground fg)
   (corfu-current :background "#ffebd1" :foreground fg)
   (corfu-border :background base3)
   (popup-face :background bg-alt :foreground fg)
   (popup-selection-face :background "#ffebd1" :foreground fg)
   (diff-added :background "#ebf5eb" :foreground green)
   (diff-changed :background "#cae4ca" :foreground yellow)
   (diff-removed :background "#fce3de" :foreground red)
   (diff-refine-added :background "#cae4ca" :foreground green)
   (diff-refine-removed :background "#d1847e" :foreground "#7a0047")
   (diff-hl-insert :foreground green :background "#ebf5eb")
   (diff-hl-change :foreground yellow :background "#cae4ca")
   (diff-hl-delete :foreground red :background "#fce3de")
   (flycheck-error :underline (list :style 'wave :color red))
   (flycheck-warning :underline (list :style 'wave :color yellow))
   (flycheck-info :underline (list :style 'wave :color cyan))
   (mode-line :foreground fg :background bg-alt)
   (mode-line-inactive :foreground base4 :background bg)
   ;; Match nvim-moonwalk's light lualine mode blocks.
   (doom-modeline-evil-normal-state :foreground "#ffffff" :background "#000000" :weight 'bold)
   (doom-modeline-evil-insert-state :foreground "#ffffff" :background blue :weight 'bold)
   (doom-modeline-evil-visual-state :foreground "#ffffff" :background cyan :weight 'bold)
   (doom-modeline-evil-replace-state :foreground "#ffffff" :background red :weight 'bold)
   (doom-modeline-evil-motion-state :foreground "#ffffff" :background magenta :weight 'bold)
   (doom-modeline-evil-operator-state :foreground "#ffffff" :background "#000000" :weight 'bold)
   (doom-modeline-evil-emacs-state :foreground "#ffffff" :background magenta :weight 'bold)
   (j/modeline-terminal :foreground "#ffffff" :background green :weight 'bold)
   (doom-modeline-bar :background blue)
   (doom-modeline-bar-inactive :background base3)
   (doom-modeline-buffer-modified :foreground yellow)
   (solaire-default-face :background bg :foreground fg)
   (solaire-hl-line-face :background base0))
  ((ansi-color-names-vector
    ["#080808" "#7a0047" "#145b0e" "#733a11"
     "#002fa7" "#5400a8" "#00566b" "#9c958d"])))
