;;; -*- lexical-binding: t; -*-
(setq user-emacs-directory (expand-file-name "~/.config/emacs/") noninteractive nil)
(load (expand-file-name "early-init.el" user-emacs-directory) nil t)
(doom-startup)
(doom-finalize)
(setq noninteractive t)
(require 'undo-fu)
(require 'undo-fu-session)
(require 'saveplace)
(let* ((dir (getenv "JIAN_TEST_DIR"))
       (file (expand-file-name "persist.txt" dir))
       (save-place-file (expand-file-name "places" dir))
       (undo-fu-session-directory (expand-file-name "undo/" dir))
       (undo-fu-session-compression nil)
       (save-place-alist nil))
  (make-directory undo-fu-session-directory t)
  ;; Batch sessions never trigger Doom's first-input activation hook.
  (save-place-mode 1)
  (if (equal (getenv "JIAN_TEST_STAGE") "write")
      (progn
        (write-region "first\nsecond\nthird\n" nil file nil 'silent)
        (find-file file)
        (buffer-enable-undo)
        (undo-boundary)
        (goto-char (point-max)) (insert "added\n") (undo-boundary)
        (save-buffer)
        (undo-fu-session-save)
        (goto-char 10)
        (save-place-to-alist)
        (save-place-alist-to-file)
        (princ "PERSIST-WRITE OK\n"))
    (save-place-load-alist-from-file)
    (find-file file)
    (save-place-find-file-hook)
    (unless (= (point) 10) (error "Cursor not restored: %s" (point)))
    (undo-fu-session-recover)
    (unless (consp buffer-undo-list) (error "Undo not recovered"))
    (undo-fu-only-undo)
    (unless (equal (buffer-string) "first\nsecond\nthird\n") (error "Undo restored wrong content"))
    (set-buffer-modified-p nil)
    (princ "PERSIST-RESTART cursor and undo OK\n")))
