;;; workflow-test.el -*- lexical-binding: t; -*-
;; Run: emacs -Q --batch -l ~/.config/doom/tests/workflow-test.el
(setq user-emacs-directory (expand-file-name "~/.config/emacs/") noninteractive nil)
(load (expand-file-name "early-init.el" user-emacs-directory) nil t)
(doom-startup)
(doom-finalize)
(setq noninteractive t debug-on-error nil)
(require 'tramp)
(doom-run-hooks 'doom-first-input-hook)
(setq doom-first-input-hook nil)
(require 'ert)
(require 'cl-lib)
(require 'evil-visualstar)
(load (expand-file-name "sources/doom+/modules/editor/evil/autoload/evil.el" doom-emacs-dir) nil t)

(defmacro j/test-file (&rest body)
  `(let ((dir (make-temp-file "jian-test-" t)))
     (unwind-protect
         (with-temp-buffer
           (setq buffer-file-name (expand-file-name "file.txt" dir))
           (evil-local-mode 1)
           (evil-normal-state)
           ,@body)
       (delete-directory dir t))))

(ert-deftest j/theme-loads ()
  (load-theme 'moonwalk-light t)
  (should (equal (doom-color 'bg) "#e4e2e0"))
  (should (equal (doom-color 'fg) "#061f4a"))
  (should (equal (doom-color 'selection) "#b8d2e5")))

(ert-deftest j/keybindings-and-reload ()
  (let ((menus (mapcar (lambda (k) (lookup-key doom-leader-map (kbd k))) '("f" "g" "h" "t"))))
    (should (cl-every #'keymapp menus))
    (should-not (lookup-key doom-leader-map (kbd "F")))
    (should (eq (lookup-key doom-leader-map (kbd "f f")) 'find-file))
    (should (eq (lookup-key doom-leader-map (kbd "f F")) '+default/find-file-under-here))
    (should-not (lookup-key doom-leader-map (kbd "v")))
    (should (eq (lookup-key doom-leader-map (kbd "x")) 'doom/toggle-scratch-buffer))
    (load (expand-file-name "config.el" doom-user-dir) nil t)
    (should (equal menus (mapcar (lambda (k) (lookup-key doom-leader-map (kbd k))) '("f" "g" "h" "t")))))
  (should (eq (lookup-key doom-leader-map (kbd "SPC")) '+fold/toggle))
  (with-temp-buffer
    (evil-local-mode 1)
    (evil-normal-state)
    (should (eq (key-binding (kbd "C-q")) 'quoted-insert))
    (dolist (state '(normal insert))
      (evil-change-state state)
      (dotimes (i 9)
        (should (eq (key-binding (kbd (format "M-%d" (1+ i))))
                    (intern (format "+workspace/switch-to-%d" i)))))))
  (should (= 1 (cl-count #'j/schedule-save-h after-change-functions)))
  (should (= 1 (cl-count #'j/save-buffer-h evil-insert-state-exit-hook))))

(ert-deftest j/motion-counts ()
  (let (called jumped)
    (cl-letf (((symbol-function 'evil-next-line) (lambda (n &rest _) (setq called (list 'logical n))))
              ((symbol-function 'evil-next-visual-line) (lambda (n &rest _) (setq called (list 'screen n))))
              ((symbol-function 'evil-set-jump) (lambda (&rest _) (setq jumped t))))
      (j/next-line nil) (should (equal called '(screen 1)))
      (j/next-line 1) (should (equal called '(logical 1))) (should-not jumped)
      (j/next-line 3) (should (equal called '(logical 3))) (should jumped))))

(ert-deftest j/visual-editing ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer)) (evil-local-mode 1)
      (insert "one\ntwo\nthree\n") (goto-char 1) (evil-normal-state)
      (execute-kbd-macro (kbd "V J"))
      (should (equal (buffer-string) "two\none\nthree\n"))
      (should (eq evil-state 'visual))
      (execute-kbd-macro (kbd "K"))
      (should (equal (buffer-string) "one\ntwo\nthree\n"))
      (execute-kbd-macro (kbd ">")) (should (eq evil-state 'visual))
      (execute-kbd-macro (kbd "<")) (should (eq evil-state 'visual)))))

(ert-deftest j/visual-literal-search-keeps-registers ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer)) (evil-local-mode 1)
      (insert "a.b a-b a.b") (goto-char 1) (evil-normal-state)
      (let ((kill-ring '("clipboard")) (evil-register-alist nil))
        (execute-kbd-macro (kbd "v 2 l *"))
        (should (= (point) 9))
        (should (equal kill-ring '("clipboard")))
        (should-not evil-register-alist)))))

(ert-deftest j/save-valid-and-new-directory ()
  (j/test-file
   (setq buffer-file-name (expand-file-name "nested/deeper/new.txt" dir))
   (insert "valid edit") (j/save-buffer-h)
   (should (file-exists-p buffer-file-name))
   (should-not (buffer-modified-p))
   (should-not j/save-timer)))

(ert-deftest j/save-on-insert-exit ()
  (j/test-file
   (evil-insert-state) (insert "insert edit") (evil-normal-state)
   (should (file-exists-p buffer-file-name))
   (should-not (buffer-modified-p))))

(ert-deftest j/save-timer-and-reload ()
  (j/test-file
   (insert "normal edit")
   (should (timerp j/save-timer))
   (should (equal (timer--time j/save-timer) (seconds-to-time 0.5)))
   (let ((old j/save-timer))
     (insert " again")
     (should-not (memq old timer-idle-list)))
   (j/save-after-pause (current-buffer))
   (should-not (buffer-modified-p))
   (insert " another")
   (load (expand-file-name "config.el" doom-user-dir) nil t)
   (should-not j/save-timer)))

(ert-deftest j/save-skips-readonly-remote-special ()
  (j/test-file
   (insert "edit")
   (setq buffer-read-only t)
   (j/schedule-save-h)
   (should-not j/save-timer)
   (j/save-buffer-h)
   (should-not (file-exists-p buffer-file-name))
   (setq buffer-read-only nil buffer-file-name "/ssh:example.invalid:/file")
   (should (file-remote-p buffer-file-name))
   (cl-letf (((symbol-function 'file-writable-p) (lambda (&rest _) (ert-fail "Remote IO attempted"))))
     (j/schedule-save-h)
     (should-not j/save-timer)
     (j/save-buffer-h))
   (setq buffer-file-name (expand-file-name "special" dir))
   (special-mode)
   (setq-local buffer-read-only nil)
   (evil-normal-state)
   (j/schedule-save-h)
   (should-not j/save-timer)
   (j/save-buffer-h)
   (should-not (file-exists-p buffer-file-name))))

(ert-deftest j/save-skips-parser-errors ()
  (j/test-file
   (insert "invalid")
   (cl-letf (((symbol-function 'treesit-parser-list) (lambda () '(existing-parser)))
             ((symbol-function 'treesit-parser-root-node) (lambda (_) 'root))
             ((symbol-function 'treesit-node-check) (lambda (_ property) (should (eq property 'has-error)) t)))
     (j/save-buffer-h)
     (should-not (file-exists-p buffer-file-name)))
   (j/save-buffer-h) (should (file-exists-p buffer-file-name))))

(ert-deftest j/save-skips-external-modification ()
  (j/test-file
   (insert "original") (j/save-buffer-h)
   (insert " local")
   (write-region "external change" nil buffer-file-name nil 'silent)
   (set-file-times buffer-file-name (time-add (current-time) 10))
   (j/save-buffer-h)
   (should (buffer-modified-p))
   (let ((file buffer-file-name))
     (should (equal (with-temp-buffer (insert-file-contents file) (buffer-string)) "external change")))))

(ert-deftest j/save-failure-does-not-retry ()
  (j/test-file
   (insert "edit")
   (let ((attempts 0))
     (cl-letf (((symbol-function 'save-buffer) (lambda (&rest _) (cl-incf attempts) (error "Test failure"))))
       (j/save-buffer-h) (j/save-buffer-h)
       (insert " more")
       (should j/save-failed)
       (should (= attempts 1))
       (should-not j/save-timer))
     (save-buffer)
     (should-not j/save-failed))))

(ert-deftest j/workspace-selection ()
  (require 'persp-mode)
  (persp-mode 1)
  (let ((original (+workspace-current-name))
        (before (+workspace-list-names))
        created)
    (unwind-protect
        (progn
          (+workspace/new)
          (setq created (+workspace-current-name))
          (should-not (member created before))
          (should (one-window-p t))
          (+workspace/switch-to (cl-position created (+workspace-list-names) :test #'equal))
          (should (equal created (+workspace-current-name))))
      (+workspace-switch original)
      (when created (+workspace-kill created t)))))

(ert-deftest j/save-skips-unwritable-file ()
  (j/test-file
   (insert "initial") (j/save-buffer-h)
   (set-file-modes buffer-file-name #o444)
   (insert " change") (j/save-buffer-h)
   (should (buffer-modified-p))))

(ert-deftest j/save-confirmation-is-deferred ()
  (j/test-file
   (insert "edit")
   (cl-letf (((symbol-function 'save-buffer) (lambda (&rest _) (y-or-n-p "Prompt?"))))
     (j/save-buffer-h)
     (should j/save-failed))))

(ert-deftest j/visual-partial-final-line ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer)) (evil-local-mode 1)
      (insert "one\ntwo") (goto-char 1) (evil-normal-state)
      (execute-kbd-macro (kbd "V J"))
      (should (equal (buffer-string) "two\none\n"))
      (should (eq evil-state 'visual)))))

(ert-deftest j/whitespace-single-activation-and-wrapping ()
  (require 'whitespace)
  (let ((calls 0)
        (original (symbol-function 'whitespace-mode)))
    (cl-letf (((symbol-function 'whitespace-mode)
               (lambda (&optional arg)
                 (cl-incf calls)
                 (funcall original arg))))
      (with-temp-buffer
        (setq buffer-file-name "/tmp/jian-whitespace.el")
        (let ((noninteractive nil)) (emacs-lisp-mode))
        (should (= calls 1))
        (should whitespace-mode)
        (should (equal whitespace-active-style '(face tabs tab-mark trailing)))
        (should truncate-lines))
      (setq calls 0)
      (with-temp-buffer
        (setq buffer-file-name "/tmp/jian-whitespace.txt")
        (let ((noninteractive nil)) (text-mode))
        (should (= calls 1))
        (should whitespace-mode)
        (should (memq 'trailing whitespace-active-style))
        (should-not truncate-lines)))))

(ert-deftest j/doom-lazy-reversion ()
  (require 'autorevert)
  (doom-auto-revert-mode 1)
  (should doom-auto-revert-mode)
  (should-not global-auto-revert-mode)
  (should auto-revert-verbose))

(ert-run-tests-batch-and-exit)
